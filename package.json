{
  "name": "build-sprint-app",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prepare-production-build.mjs",
    "test": "node --experimental-strip-types --test tests/rules.test.ts && vitest run",
    "deploy": "npx @convex-dev/static-hosting deploy",
    "testing:verify": "node scripts/convex-testing.mjs verify",
    "testing:push": "node scripts/convex-testing.mjs push",
    "build:testing": "tsc --noEmit && vite build --mode development --outDir dist-v1-testing && node scripts/prepare-testing-build.mjs",
    "preview:testing": "node scripts/serve-testing-build.mjs",
    "release:check": "node scripts/production-preflight.mjs",
    "predeploy": "node scripts/production-preflight.mjs --before-deploy",
    "build:option-a": "tsc --noEmit && vite build --config vite.option-a.config.ts && node scripts/prepare-option-a.mjs",
    "release:option-a": "node scripts/release-option-a.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "0.0.96",
    "@convex-dev/static-hosting": "^0.2.1",
    "convex": "^1.46.0",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "convex-test": "^0.0.61",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
